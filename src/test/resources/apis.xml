<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE curls PUBLIC "-//PAOHAIJIAO//DTD API CURL 1.0//EN"
        "classpath:dtd/Jquick-curl.dtd">
<curls namespace="com.paohaijiao.UserApi">
    <curl name="all" returnClass="java.util.List">
        curl -X GET http://localhost:8080/api/users/1
    </curl>
    <curl name="findByName" returnClass="java.util.Map">
        curl -X GET ${host}
    </curl>

    <curl name="search" returnClass="java.util.List">
        curl -X POST http://localhost:8080/api/users/createUser \
        -H "Content-Type: application/json" \
        -d '{"name":"John Doe","email":"john@example.com"}'
    </curl>
</curls>