<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE curls PUBLIC "-//PAOHAIJIAO//DTD API CURL 1.0//EN"
        "classpath:dtd/Jquick-curl.dtd">
<curls namespace="com.paohaijiao.UserApi">
    <curl name="getUser" returnClass="com.paohaijiao.model.User">
        <if test="id != null &amp;&amp; id > 0">
            curl -X GET http://localhost:8080/api/users/#{id}
        </if>
        <if test="name != null &amp;&amp; name.length() > 0">
            curl -X GET http://localhost:8080/api/users?name=#{name}
        </if>
    </curl>

    <curl name="searchUsers" returnClass="java.util.List">
        curl -X POST http://localhost:8080/api/users/search \
        -H "Content-Type: application/json" \
        -d '{
        <if test="name != null &amp;&amp; !name.isEmpty()">
            "name": "#{name}",
        </if>
        <if test="age != null &amp;&amp; age >= 18">
            "age": #{age},
        </if>
        <if test="roles != null &amp;&amp; roles.size() > 0">
            "roles": [
            <foreach collection="roles" item="role" separator=",">
                "#{role}"
            </foreach>
            ],
        </if>
        <if test="address != null &amp;&amp; address.city != null">
            "city": "#{address.city}",
            "street": "#{address.street}"
        </if>
        "enabled": true
        }'
    </curl>

    <curl name="batchOperation" returnClass="java.lang.String">
        <choose>
            <when test="operation == 'create'">
                curl -X POST http://localhost:8080/api/users \
                -H "Content-Type: application/json" \
                -d '{"name": "#{name}", "email": "#{email}"}'
            </when>
            <when test="operation == 'update'">
                curl -X PUT http://localhost:8080/api/users/#{id} \
                -H "Content-Type: application/json" \
                -d '{"name": "#{name}", "email": "#{email}"}'
            </when>
            <when test="operation == 'delete'">
                curl -X DELETE http://localhost:8080/api/users/#{id}
            </when>
            <otherwise>
                curl -X GET http://localhost:8080/api/users
            </otherwise>
        </choose>
    </curl>

    <curl name="dynamicQuery" returnClass="java.util.List">
        curl -X GET "http://localhost:8080/api/users?
        <where>
            <if test="name != null">
                name=#{name}
            </if>
            <if test="email != null">
                AND email=#{email}
            </if>
            <if test="age != null">
                AND age=#{age}
            </if>
            <if test="city != null">
                AND city=#{city}
            </if>
        </where>
        "
    </curl>

    <curl name="updateUser" returnClass="com.paohaijiao.model.User">
        curl -X PUT http://localhost:8080/api/users/#{id} \
        -H "Content-Type: application/json" \
        -d '{
        <set>
            <if test="name != null">
                "name": "#{name}",
            </if>
            <if test="email != null">
                "email": "#{email}",
            </if>
            <if test="age != null">
                "age": #{age},
            </if>
            <if test="phone != null">
                "phone": "#{phone}"
            </if>
        </set>
        }'
    </curl>

    <curl name="advancedSearch" returnClass="java.util.List">
        curl -X POST http://localhost:8080/api/users/advanced \
        -H "Content-Type: application/json" \
        -d '{
        <trim prefix="{" suffix="}" prefixOverrides=",">
            <if test="name != null">
                "name": "#{name}",
            </if>
            <if test="email != null">
                "email": "#{email}",
            </if>
            <if test="ageFrom != null">
                "ageFrom": #{ageFrom},
            </if>
            <if test="ageTo != null">
                "ageTo": #{ageTo},
            </if>
            <if test="tags != null &amp;&amp; tags.size() > 0">
                "tags": [
                <foreach collection="tags" item="tag" separator=",">
                    "#{tag}"
                </foreach>
                ]
            </if>
        </trim>
        }'
    </curl>

    <curl name="batchCreate" returnClass="java.util.List">
        curl -X POST http://localhost:8080/api/users/batch \
        -H "Content-Type: application/json" \
        -d '{
        "users": [
        <foreach collection="userList" item="user" separator=",">
            {
            "name": "#{user.name}",
            "email": "#{user.email}"
        </foreach>
        ]
        }'
    </curl>

    <curl name="complexCondition" returnClass="java.util.Map">
        <if test="user != null &amp;&amp; user.role == 'ADMIN' &amp;&amp; user.permissions.contains('WRITE')">
            curl -X POST http://localhost:8080/api/admin/users \
            -H "Authorization: Bearer #{token}" \
            -H "Content-Type: application/json" \
            -d '{
            "username": "#{user.username}",
            "level": #{user.level}
            }'
        </if>
        <if test="user != null &amp;&amp; user.role == 'USER'">
            curl -X GET http://localhost:8080/api/users/#{user.id}
        </if>
    </curl>

</curls>